# ==============================================================================
# LEDGER FINANCIAL MANAGER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Persistence (MANDATORY)
# Provide your MongoDB Atlas connection string (e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ledger?retryWrites=true&w=majority)
MONGODB_URI=

# Security & Authentication (MANDATORY)
# Strong random secret key used for signing JWT session tokens
JWT_SECRET=

# Bcrypt hash of your owner security PIN (generate using bcryptjs or standard bcrypt with 10 salt rounds)
# Example bcrypt hash for a custom 4-6 digit PIN
APP_PIN_HASH=

# Session Cookie Name (Optional, defaults to ledger_session)
SESSION_COOKIE_NAME=ledger_session

# Paystack Banking & Mobile Money Integration (Ghana & West Africa rails)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_WEBHOOK_SECRET=

# Server Configuration
PORT=3000
NODE_ENV=development
DEFAULT_CURRENCY=GHS
