# ==============================================================================
# LEDGER FINANCIAL MANAGER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Persistence (MANDATORY)
# Provide your MongoDB Atlas connection string (e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ledger?retryWrites=true&w=majority)
MONGODB_URI=

# Security & Authentication (MANDATORY)
# Strong random secret key used for signing JWT session tokens
JWT_SECRET=

# Stealth Admin Secret Key (Enter in Secrets to unlock stealth admin access)
ADMIN_SECRET_KEY=

# Bcrypt hash of your owner security PIN (generate using bcryptjs or standard bcrypt with 10 salt rounds)
# Example bcrypt hash for a custom 4-6 digit PIN
APP_PIN_HASH=

# Session Cookie Name (Optional, defaults to ledger_session)
SESSION_COOKIE_NAME=ledger_session

# Paystack Banking & Mobile Money Integration (Ghana & West Africa rails)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_WEBHOOK_SECRET=

# Server Configuration
PORT=3000
NODE_ENV=development
DEFAULT_CURRENCY=GHS

# Google Gemini AI & Live Spoken Audio API
GEMINI_API_KEY=

# Google OAuth 2.0 Web Client ID (Google Sign-In)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Email Dispatch Service (for Password Reset verification codes & notifications)
# Option A: Standard SMTP / Gmail App Password (recommended for direct Gmail sending)
# To use Gmail: generate a 16-character App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ledger Security <noreply@ledger.app>

# Option B: Resend API Key (alternative transactional email service from resend.com)
RESEND_API_KEY=

