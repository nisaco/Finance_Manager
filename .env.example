# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV=development

# Database (optional external MongoDB Atlas URI; if not provided, Ledger automatically persists to atomic server disk storage)
MONGODB_URI=

# Security & Authentication
JWT_SECRET=replace_with_a_long_random_string_in_production
SESSION_COOKIE_NAME=ledger_session
# Optional PIN hash or default PIN (default is '1234' for quick setup if unset)
APP_PIN_HASH=

# Paystack API credentials (supports Test and Live keys)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_WEBHOOK_SECRET=

# Defaults
DEFAULT_CURRENCY=GHS
FRONTEND_ORIGIN=http://localhost:3000

